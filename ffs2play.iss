; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

#define MyAppName "FFS2Play2"
#define MyAppVersion "2_1_1"
#define MyAppPublisher "FFS2"
#define MyAppURL "http://ffs2play.fr/"
#define MyAppExeName "ffs2play.exe"



[Setup]
; NOTE: The value of AppId uniquely identifies this application.
; Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{DDD8FEB8-445D-4F0B-82E1-D9140BEEB11F}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
;AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={pf}\{#MyAppName}
DisableProgramGroupPage=yes
LicenseFile=E:\devel\git\ffs2play\LICENSE.GPLv3
InfoBeforeFile=E:\devel\git\ffs2play\changelog.txt
OutputDir=E:\devel\git\ffs2play\package
OutputBaseFilename=ffs2play_{#MyAppVersion}_win
SetupIconFile=E:\devel\git\ffs2play\ffs2play_48x48.ico
Compression=lzma
SolidCompression=yes

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"
Name: "french"; MessagesFile: "compiler:Languages\French.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked
Name: "quicklaunchicon"; Description: "{cm:CreateQuickLaunchIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked; OnlyBelowVersion: 0,6.1

[Files]
Source: ".\release\ffs2play.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "E:\devel\git\ffs2play\release\libeay32.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "E:\devel\git\ffs2play\release\Microsoft.FlightSimulator.SimConnect.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "E:\devel\git\ffs2play\release\Qt5Core.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "E:\devel\git\ffs2play\release\Qt5Gui.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "E:\devel\git\ffs2play\release\Qt5Network.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "E:\devel\git\ffs2play\release\Qt5Sql.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "E:\devel\git\ffs2play\release\Qt5Svg.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "E:\devel\git\ffs2play\release\Qt5Widgets.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "E:\devel\git\ffs2play\release\Qt5Xml.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "E:\devel\git\ffs2play\release\SimConnect.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "E:\devel\git\ffs2play\release\ffs2play.qss"; DestDir: "{app}"; Flags: ignoreversion
Source: "E:\devel\git\ffs2play\release\translations\*"; DestDir: "{app}\translations"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "E:\devel\git\ffs2play\release\platforms\*"; DestDir: "{app}\platforms"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "E:\devel\git\ffs2play\release\sqldrivers\*"; DestDir: "{app}\sqldrivers"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "E:\devel\git\ffs2play\release\iconengines\*"; DestDir: "{app}\iconengines"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "E:\devel\git\ffs2play\release\styles\*"; DestDir: "{app}\styles"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "E:\devel\git\ffs2play\release\imageformats\*"; DestDir: "{app}\imageformats"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "E:\devel\git\ffs2play\release\bearer\*"; DestDir: "{app}\bearer"; Flags: ignoreversion recursesubdirs createallsubdirs

; NOTE: Don't use "Flags: ignoreversion" on any shared system files

[Icons]
Name: "{commonprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{commondesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon
Name: "{userappdata}\Microsoft\Internet Explorer\Quick Launch\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: quicklaunchicon

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent

